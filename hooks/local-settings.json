{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/git/turnstone-memory/scripts/sync.sh start",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/git/turnstone-memory/scripts/sync.sh note",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/git/turnstone-memory/scripts/sync.sh end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
